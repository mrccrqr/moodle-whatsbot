# ============================================================
# Moodle WhatsBot — Variaveis de Ambiente
# ============================================================
# Copie este arquivo para moodle/.env e preencha os valores.
# Apenas MOODLE_USER, MOODLE_PASS e ADMIN_NUMERO sao obrigatorios.
# O token do Moodle e gerado automaticamente no primeiro login.
# ============================================================

# --- Obrigatorios ---

# Credenciais de login no Moodle (mesmo usuario/senha que voce usa no site)
MOODLE_USER=
MOODLE_PASS=

# Seu numero de WhatsApp: so DDD + numero (ex: 77991234567). Com ou sem o 9, o bot descobre sozinho.
# O bot envia alertas de erro e permite comandos admin apenas para este numero
ADMIN_NUMERO=

# --- Opcionais ---

# Host do Moodle (padrao: moodle4.uesb.br)
# MOODLE_HOST=moodle4.uesb.br

# ID da categoria pai no Moodle para filtrar cursos do semestre
# Se nao definido, o código detecta o semestre automaticamente pelo nome dos cursos
# MOODLE_PARENT_CAT_ID=

# JID alternativo do admin (alguns dispositivos usam LID em vez de JID)
# ADMIN_LID=

# Destinos das notificacoes. Nao precisa preencher: no privado do bot, mande /add-grupo ou /add-pessoa
# (o bot grava aqui sozinho). Manual: IDs de grupo ou DDD + numero, separados por virgula.
# Se vazio, as notificacoes vao para o ADMIN_NUMERO
DESTINOS=

# Moodle bloqueado para o servidor (ex.: VPS fora do Brasil): as chamadas saem por um repasse no Brasil.
# Ex.: API Gateway (HTTP API) da AWS em sa-east-1 repassando para o Moodle. Ver README.
# MOODLE_API_HOST=xxxxxxxx.execute-api.sa-east-1.amazonaws.com
# Ou um proxy SOCKS com saida no Brasil:
# MOODLE_PROXY=socks5://127.0.0.1:1080

# --- Telegram (fallback opcional) ---
# Se configurado, o bot envia pelo Telegram quando o WhatsApp falha
# TG_TOKEN=
# TG_CHAT_ID=
